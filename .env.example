# Velyric local development environment.
# Generate a working .env with fresh local secrets: node scripts/env-local.mjs
# Variables ending in _SECRET hold the secret value locally; staging and production use _SECRET_ARN instead.

VELYRIC_ENV=local
VELYRIC_AWS_REGION=eu-central-1
VELYRIC_LOG_LEVEL=info
VELYRIC_TERMS_VERSION=2026-09-01
VELYRIC_PUBLIC_WEB_ORIGIN=http://localhost:3000
VELYRIC_PUBLIC_API_ORIGIN=http://localhost:4000
VELYRIC_CONTROL_API_URL=http://127.0.0.1:4000
VELYRIC_CONTROL_API_INTERNAL_URL=http://127.0.0.1:4001
VELYRIC_STATUS_PAGE_URL=
# Optional. Loaded only when VELYRIC_ENV=production.
VELYRIC_GA_MEASUREMENT_ID=
# Optional. HetrixTools API key for the public /status page uptime widget.
VELYRIC_HETRIXTOOLS_API_KEY_SECRET=
VELYRIC_VOICE_PREVIEW_OPENAI_API_KEY=
# Optional. Admin-only browser test call in the setup wizard (microphone instead of a phone number).
# Set to true to expose it in the API and the web app; anything else removes it from both.
VELYRIC_WEB_TEST_CALL_ENABLED=false
# Search engines and AI crawlers may index the public site. Defaults to true only when VELYRIC_ENV=production.
VELYRIC_PUBLIC_INDEXING=false
# Optional. Cloudflare Turnstile bot check on the signup form (Security > Turnstile in the
# Cloudflare dashboard, widget mode "Managed"). Leave both empty to keep signup open with no
# check. The site key is public and goes to the browser; the secret must use
# VELYRIC_TURNSTILE_SECRET_ARN instead of _SECRET in staging/production.
VELYRIC_TURNSTILE_SITE_KEY=
VELYRIC_TURNSTILE_SECRET=
# Optional. Search engine site verification tokens for Search Console and Bing Webmaster Tools.
VELYRIC_GOOGLE_SITE_VERIFICATION=
VELYRIC_BING_SITE_VERIFICATION=
VELYRIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
VELYRIC_SENTRY_DSN=

VELYRIC_LOCAL_POSTGRES_PASSWORD=
VELYRIC_LOCAL_APP_PASSWORD=
VELYRIC_LOCAL_READONLY_PASSWORD=
VELYRIC_LOCAL_REDIS_PASSWORD=
VELYRIC_LOCAL_MINIO_PASSWORD=
VELYRIC_DATABASE_MIGRATOR_URL=
VELYRIC_DATABASE_URL_SECRET=
VELYRIC_REDIS_URL_SECRET=
VELYRIC_REDIS_URL=
VELYRIC_NATS_URL=nats://127.0.0.1:54222
VELYRIC_TEMPORAL_ADDRESS=127.0.0.1:57233
VELYRIC_TEMPORAL_NAMESPACE=velyric-local
VELYRIC_S3_ENDPOINT=http://127.0.0.1:59000
VELYRIC_S3_BUCKET_PREFIX=velyric-local
AWS_ACCESS_KEY_ID=velyric-local
AWS_SECRET_ACCESS_KEY=

VELYRIC_SERVICE_SIGNING_KEY_SECRET=
VELYRIC_SERVICE_SIGNING_KEY=
VELYRIC_SERVICE_JWKS_SECRET=
VELYRIC_SERVICE_JWKS=
VELYRIC_SERVICE_JWKS_URL=http://127.0.0.1:4001/internal/v1/.well-known/jwks.json
CONTROL_API_SERVICE_KEY_ID=control-api-local
VOICE_RUNTIME_SERVICE_KEY_ID=voice-runtime-local
DOCUMENT_WORKER_SERVICE_KEY_ID=document-worker-local
EVAL_RUNNER_SERVICE_KEY_ID=eval-runner-local

VELYRIC_PROVIDER_SIMULATOR_URL=http://127.0.0.1:4010
VELYRIC_PROVIDER_SIMULATOR_PORT=4010
VELYRIC_SIMULATOR_SEED=velyric-local
VELYRIC_SIMULATOR_STABLE_IDS=false
VELYRIC_SIMULATOR_STRIPE_WEBHOOK_URL=http://127.0.0.1:4000/v1/webhooks/providers/stripe
VELYRIC_SIMULATOR_OPENAI_WEBHOOK_URL=http://127.0.0.1:7000/v1/webhooks/openai/live
VELYRIC_PROVIDER_MODE_OPENAI=simulator
VELYRIC_PROVIDER_MODE_TELNYX=simulator
VELYRIC_PROVIDER_MODE_TWILIO=simulator
VELYRIC_PROVIDER_MODE_STRIPE=simulator
VELYRIC_PROVIDER_MODE_BILLINGO=simulator
VELYRIC_PROVIDER_MODE_GOOGLE=simulator
VELYRIC_PROVIDER_MODE_MICROSOFT=simulator
VELYRIC_PROVIDER_MODE_AWS_SES=simulator
VELYRIC_SESSION_SIGNING_KEY_SECRET=
VELYRIC_STRIPE_SECRET_KEY_SECRET=sk_test_simulator
VELYRIC_STRIPE_WEBHOOK_SIGNING_SECRET=whsec_simulator
VELYRIC_OPENAI_WEBHOOK_SECRET=whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw
VELYRIC_TELNYX_API_KEY_SECRET=KEY_simulator
# Optional in simulator mode (a fixed dummy key is used); required once VELYRIC_PROVIDER_MODE_TELNYX is sandbox/live.
VELYRIC_TELNYX_WEBHOOK_PUBLIC_KEY=
VELYRIC_TWILIO_AUTH_TOKEN_SECRET=simulator-auth-token
VELYRIC_BILLINGO_API_KEY_SECRET=billingo-simulator
# Optional in simulator mode (a fixed dummy client is used). Required once
# VELYRIC_PROVIDER_MODE_GOOGLE/MICROSOFT is sandbox/live; same JSON on both lines per provider:
# CONTROL_API_GOOGLE_OAUTH_CLIENT_SECRET={"client_id":"<id>","client_secret":"<secret>"}
# CONNECTOR_WORKER_GOOGLE_OAUTH_CLIENT_SECRET={"client_id":"<id>","client_secret":"<secret>"}
# WORKFLOW_WORKER_GOOGLE_OAUTH_CLIENT_SECRET={"client_id":"<id>","client_secret":"<secret>"}
# CONTROL_API_MICROSOFT_OAUTH_CLIENT_SECRET={"client_id":"<id>","client_secret":"<secret>"}
# CONNECTOR_WORKER_MICROSOFT_OAUTH_CLIENT_SECRET={"client_id":"<id>","client_secret":"<secret>"}

VELYRIC_LEGAL_ENTITY_NAME=
VELYRIC_LEGAL_ENTITY_ADDRESS=
VELYRIC_LEGAL_ENTITY_REGISTRATION=
VELYRIC_LEGAL_ENTITY_TAX_NUMBER=
VELYRIC_PRIVACY_CONTACT_EMAIL=
VELYRIC_SALES_CONTACT_EMAIL=

CONTROL_API_HOST=127.0.0.1
CONTROL_API_PUBLIC_PORT=4000
CONTROL_API_INTERNAL_PORT=4001
CONTROL_API_CORS_ALLOWED_ORIGINS=http://localhost:3000
CONTROL_API_DATABASE_ASSUME_ROLE=true
CONTROL_API_REQUIRE_VECTOR_SEARCH=true
CONTROL_API_LOCAL_VAULT_DIR=.local/vault
CONTROL_API_CURSOR_KEY_SECRET=
CONTROL_API_API_KEY_PEPPER_SECRET=
CONTROL_API_STATE_KEY_SECRET=

WORKFLOW_WORKER_HOST=127.0.0.1
WORKFLOW_WORKER_PORT=7200
WORKFLOW_WORKER_DATABASE_ASSUME_ROLE=true
WORKFLOW_WORKER_LOCAL_VAULT_DIR=.local/vault
WORKFLOW_WORKER_EMAIL_FROM=Velyric <no-reply@velyric.local>
# Local Mailpit does not require auth. For a real relay use:
# VELYRIC_SMTP_URL_SECRET=smtps://<username>:<password>@<host>:465
VELYRIC_SMTP_URL_SECRET=smtp://127.0.0.1:51025
WORKFLOW_WORKER_TELNYX_CONNECTION_ID=simulator-connection
WORKFLOW_WORKER_BILLINGO_BLOCK_ID=1
WORKFLOW_WORKER_OPENAI_ADMIN_KEY_SECRET=sk-admin-simulator
WORKFLOW_WORKER_STREAM_REPLICAS=1

CONNECTOR_WORKER_HOST=127.0.0.1
CONNECTOR_WORKER_PORT=7300
CONNECTOR_WORKER_DATABASE_ASSUME_ROLE=true
CONNECTOR_WORKER_LOCAL_VAULT_DIR=.local/vault
CONNECTOR_WORKER_EGRESS_ALLOW_HTTP=true

VOICE_RUNTIME_HOST=127.0.0.1
VOICE_RUNTIME_PUBLIC_PORT=7000
VOICE_RUNTIME_ADMIN_PORT=7001
VOICE_RUNTIME_DRAIN_TIMEOUT_SECONDS=1800
VOICE_RUNTIME_FALLBACK_MAX_CALLS_PER_TENANT=1
VOICE_RUNTIME_OPENAI_API_KEY_SECRET=sk-simulator-voice
VOICE_RUNTIME_MODEL_LIVE=gpt-live-1
VOICE_RUNTIME_MODEL_ROUTINE=gpt-5.6-luna
VOICE_RUNTIME_MODEL_COMPLEX=gpt-5.6-terra
VOICE_RUNTIME_MODEL_ESCALATION=gpt-5.6-sol
VOICE_RUNTIME_MODEL_FRONTIER=gpt-6-astra

METERING_WORKER_HOST=127.0.0.1
METERING_WORKER_PORT=7100
METERING_WORKER_DATABASE_ASSUME_ROLE=true
METERING_WORKER_STREAM_REPLICAS=1
METERING_WORKER_TOKEN_PRICES={"gpt-5.6-luna":{"input_usd_micros_per_million":200000,"output_usd_micros_per_million":1200000},"gpt-5.6-terra":{"input_usd_micros_per_million":600000,"output_usd_micros_per_million":2400000},"gpt-5.6-sol":{"input_usd_micros_per_million":1500000,"output_usd_micros_per_million":6000000},"gpt-6-astra":{"input_usd_micros_per_million":3000000,"output_usd_micros_per_million":12000000}}

DOCUMENT_WORKER_HOST=127.0.0.1
DOCUMENT_WORKER_PORT=7400
DOCUMENT_WORKER_CLAMD_HOST=127.0.0.1
DOCUMENT_WORKER_CLAMD_PORT=53310
DOCUMENT_WORKER_LOCAL_VAULT_DIR=.local/vault
DOCUMENT_WORKER_STREAM_REPLICAS=1

EVAL_RUNNER_HOST=127.0.0.1
EVAL_RUNNER_PORT=7500
EVAL_RUNNER_LOCAL_VAULT_DIR=.local/vault
EVAL_RUNNER_STREAM_REPLICAS=1
