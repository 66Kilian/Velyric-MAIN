{
  "name": "@velyric/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/simulator/bin.js"
  ],
  "exports": {
    ".": {
      "@velyric/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "provider-simulator": "tsc -p tsconfig.build.json && node dist/simulator/bin.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@velyric/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "bin": {
    "velyric-provider-simulator": "./dist/simulator/bin.js"
  }
}
